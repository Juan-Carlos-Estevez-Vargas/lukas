{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Entorno local (wrangler dev). Los bindings y vars no se heredan: cada entorno declara los suyos.
  "name": "lukas-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "development",
    "CORS_ORIGINS": "http://localhost:8081,http://localhost:5173"
  },
  // Rate Limiting de Workers: `period` solo admite 10 o 60 segundos y debe coincidir con el código.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "lukas-api-staging",
      "vars": { "ENVIRONMENT": "staging", "CORS_ORIGINS": "https://lukas-staging.pages.dev" },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
      ]
    },
    "production": {
      "name": "lukas-api",
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 0.2 },
      "vars": { "ENVIRONMENT": "production", "CORS_ORIGINS": "https://lukas.pages.dev" },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "3001", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "3002", "simple": { "limit": 5, "period": 60 } }
      ]
    }
  }
}
