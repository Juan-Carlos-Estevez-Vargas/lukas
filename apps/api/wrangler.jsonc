{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Entorno local (wrangler dev). Los bindings y vars no se heredan: cada entorno declara los suyos.
  "name": "lukas-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "development",
    "CORS_ORIGINS": "http://localhost:8081,http://localhost:5173"
  },
  // Rate Limiting de Workers: `period` solo admite 10 o 60 segundos y debe coincidir con el código.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "env": {
    // Previews por PR: el workflow despliega un Worker `lukas-api-pr-<N>` con su propia rama de Neon
    // y fija AUTH_URL y PASSKEY_RP_ID con --var, porque dependen del subdominio de workers.dev.
    "preview": {
      "name": "lukas-api-preview",
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "preview", "CORS_ORIGINS": "http://localhost:8081" },
      // Sin cron en previews: el plan gratis admite pocos y la TRM se pide al vuelo.
      "triggers": { "crons": [] },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "4001", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "4002", "simple": { "limit": 5, "period": 60 } }
      ]
    },
    // Staging y producción reciben AUTH_URL, PASSKEY_RP_ID y CORS_ORIGINS por --var en deploy.yml,
    // calculados con los subdominios reales de workers.dev y Pages.
    "staging": {
      "name": "lukas-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "CORS_ORIGINS": "https://staging.lukas-web-e7j.pages.dev"
      },
      // TRM diaria a las 8:00 de Bogotá (13:00 UTC), ya publicada por la Superfinanciera.
      "triggers": { "crons": ["0 13 * * *"] },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
      ]
    },
    "production": {
      "name": "lukas-api",
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 0.2 },
      "vars": { "ENVIRONMENT": "production", "CORS_ORIGINS": "https://lukas-web-e7j.pages.dev" },
      "triggers": { "crons": ["0 13 * * *"] },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "3001", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "3002", "simple": { "limit": 5, "period": 60 } }
      ]
    }
  }
}
