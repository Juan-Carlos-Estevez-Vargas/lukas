{
  "expo": {
    "name": "Lukas",
    "slug": "lukas",
    "owner": "juancarlosestevezvargas",
    "scheme": "lukas",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "co.lukas.app",
      "edgeToEdgeEnabled": true,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "co.lukas.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lukas usa Face ID para desbloquear la app."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "payments"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lukas usa la cámara para tomar la foto de tus recibos.",
          "photosPermission": "Lukas usa tus fotos para adjuntar recibos a tus gastos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "06505b4e-0280-49dc-837b-3afb58c5cd59"
      }
    }
  }
}
