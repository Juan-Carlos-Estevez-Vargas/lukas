{
  "expo": {
    "name": "Lukas",
    "slug": "lukas",
    "owner": "juancarlosestevezvargas",
    "scheme": "lukas",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "co.lukas.app",
      "edgeToEdgeEnabled": true,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "co.lukas.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lukas usa Face ID para desbloquear la app."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "payments"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lukas usa la cámara para tomar la foto de tus recibos.",
          "photosPermission": "Lukas usa tus fotos para adjuntar recibos a tus gastos.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MonthAvailable",
              "label": "Disponible del mes",
              "description": "Cuánto te queda este mes. Se oculta si usas PIN o modo discreto.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "not_keyguard",
              "updatePeriodMillis": 0
            },
            {
              "name": "QuickExpense",
              "label": "Gasto rápido",
              "description": "Registra un gasto con un toque.",
              "minWidth": "180dp",
              "minHeight": "50dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Lukas",
      "lang": "es-CO",
      "description": "Tus finanzas personales, claras y en pesos."
    },
    "extra": {
      "eas": {
        "projectId": "06505b4e-0280-49dc-837b-3afb58c5cd59"
      }
    }
  }
}
