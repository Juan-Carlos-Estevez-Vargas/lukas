{
  "cli": {
    "version": ">= 27.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lukas-api-staging.juank2001estevezvargas.workers.dev",
        "EXPO_PUBLIC_WEB_URL": "https://staging.lukas-web-e7j.pages.dev",
        "LUKAS_DEV_CLIENT": "1",
        "EXPO_PUBLIC_ENVIRONMENT": "staging"
      }
    },
    "production": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lukas-api.juank2001estevezvargas.workers.dev",
        "EXPO_PUBLIC_WEB_URL": "https://lukas-web-e7j.pages.dev",
        "EXPO_PUBLIC_ENVIRONMENT": "production"
      }
    },
    "play": {
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
