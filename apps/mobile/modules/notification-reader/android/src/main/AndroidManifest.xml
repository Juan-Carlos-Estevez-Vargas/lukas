<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Lector de notificaciones: Android solo lo activa cuando la persona lo autoriza en
      Ajustes > Acceso a notificaciones. No exporta datos: lo que lee se queda en la app.
    -->
    <service
      android:name="co.lukas.notifications.LukasNotificationListener"
      android:label="Lukas"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
