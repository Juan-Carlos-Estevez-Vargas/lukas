{
  "name": "@lukas/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App de Lukas para Android, iOS y web (Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "build": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@lukas/ui": "workspace:*",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-linking": "58.0.16",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@lukas/config": "workspace:*",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "vitest": "5.0.4"
  }
}
