# Cabeceras de Cloudflare Pages para la web de Lukas.
# COOP + COEP aíslan el origen: expo-sqlite (wa-sqlite) necesita SharedArrayBuffer. Se usa
# require-corp y no credentialless porque Safari solo admite require-corp.
# 'wasm-unsafe-eval' permite compilar el .wasm de SQLite sin abrir eval() a JavaScript, y el worker
# de expo-sqlite se crea desde un blob: generado por la propia app.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.workers.dev; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Página del captcha (Turnstile): sin COEP, porque el iframe de Cloudflare no lo envía, y con una
# CSP propia que solo abre challenges.cloudflare.com. No guarda ni lee datos de la app.
/captcha/*
  ! Content-Security-Policy
  ! Cross-Origin-Embedder-Policy
  ! Cross-Origin-Resource-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src https://challenges.cloudflare.com; style-src 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  Cache-Control: public, max-age=3600

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
