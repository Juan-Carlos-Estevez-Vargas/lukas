{
  "extends": "@lukas/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "allowJs": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "app",
    "src",
    "e2e",
    "app.config.ts",
    "app.config.test.ts",
    "pwa.test.ts",
